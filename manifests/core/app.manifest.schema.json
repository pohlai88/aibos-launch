{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "schemaVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Schema version for validation"
        },
        "manifest": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "features": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9-]+$"
                            },
                            "name": {
                                "type": "string"
                            },
                            "version": {
                                "type": "string",
                                "pattern": "^\\d+\\.\\d+\\.\\d+$"
                            },
                            "enabled": {
                                "type": "boolean"
                            },
                            "permissions": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "version",
                            "enabled"
                        ]
                    }
                },
                "permissions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9-]+$"
                            },
                            "name": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "name"
                        ]
                    }
                },
                "config": {
                    "type": "object",
                    "properties": {
                        "environment": {
                            "type": "string",
                            "enum": [
                                "development",
                                "production",
                                "test"
                            ]
                        },
                        "logging": {
                            "type": "object",
                            "properties": {
                                "level": {
                                    "type": "string",
                                    "enum": [
                                        "debug",
                                        "info",
                                        "warn",
                                        "error"
                                    ]
                                },
                                "format": {
                                    "type": "string",
                                    "enum": [
                                        "json",
                                        "text"
                                    ]
                                }
                            }
                        },
                        "security": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                }
            },
            "required": [
                "version",
                "name",
                "features",
                "permissions"
            ]
        },
        "migrations": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        }
    },
    "required": [
        "schemaVersion",
        "manifest"
    ]
}
